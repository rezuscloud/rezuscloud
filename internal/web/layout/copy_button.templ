package layout

// CopyButtonProps configures a CopyButton component.
// The button reads its data-copy-text attribute on click and writes it to
// the system clipboard via navigator.clipboard.writeText(). Visual feedback
// ("Copied!") is shown for 1.5s via Alpine.js state.
//
// No external JS library — Alpine.js x-data handles state inline.
type CopyButtonProps struct {
	Text     string // the text to copy (HTML-attribute-escaped into data-copy-text)
	Label    string // visible label; defaults to "Copy" if empty
	IconOnly bool   // if true, show only the clipboard icon (no label) — aria-label is added
	Class    string // additional CSS classes appended to ds-copy-btn
}

// copyLabel returns the visible label with a sane default.
func copyLabel(label string) string {
	if label == "" {
		return "Copy"
	}
	return label
}

// feedbackScript is the Alpine.js click handler that copies the text and
// flips the copied state for 1.5s. It is inline so callers don't need to
// load any additional JS.
const feedbackScript = `navigator.clipboard.writeText($el.dataset.copyText).then(function() {
	var d = $data; d.copied = true;
	setTimeout(function() { d.copied = false; }, 1500);
})`

// CopyButton renders a <button data-copy-text="..."> that copies the text
// to the clipboard when clicked. Uses Alpine.js for the "Copied!" feedback.
//
// A11y: when IconOnly is true, aria-label is added so screen readers
// announce the button's purpose.
//
// The default label is rendered as text content so the button works without
// JavaScript (progressive enhancement). On click, Alpine.js toggles the
// label to "Copied!" for 1.5s.
templ CopyButton(props CopyButtonProps) {
	<button
		type="button"
		class={ templ.Classes("ds-btn", "ds-copy-btn", templ.KV(props.Class, props.Class != "")) }
		data-copy-text={ props.Text }
		if props.IconOnly {
			aria-label="Copy to clipboard"
		}
		x-data="{ copied: false }"
		x-on:click={ feedbackScript }
	>
		<svg class="ds-copy-btn-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
			<path d="M3.5 3.5h7v2h1V3.5a1 1 0 00-1-1h-7a1 1 0 00-1 1v9a1 1 0 001 1h2v-1h-2v-9z"></path>
			<path d="M5.5 5.5h7a1 1 0 011 1v7a1 1 0 01-1 1h-7a1 1 0 01-1-1v-7a1 1 0 011-1zm0 1v7h7v-7h-7z"></path>
		</svg>
		if !props.IconOnly {
			<span class="ds-copy-btn-label" x-show="!copied">{ copyLabel(props.Label) }</span>
			<span class="ds-copy-btn-feedback" x-show="copied" x-cloak>Copied!</span>
		}
	</button>
}
