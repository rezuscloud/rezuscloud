package layout

// CodeBlockProps configures a CodeBlock component.
//
// CodeBlock renders a <pre><code> block with optional caption and copy
// button. The Code field is HTML-escaped (XSS-safe) — callers can pass raw
// user input safely.
//
// For v1, no syntax highlighting. Adding highlight.js or Prism is a future
// enhancement; the Language field is preserved on the <code> element as a
// class hook ("language-yaml", "language-json", etc.) for when this is added.
type CodeBlockProps struct {
	ID       string // optional DOM id (for targeting via hx-target)
	Language string // optional language hint ("yaml", "json", "shell", "")
	Code     string // raw code text
	MaxLines int    // optional max visible lines (overflow: auto)
	ShowCopy bool   // if true, render a CopyButton in the header
	Caption  string // optional caption shown above the code block
}

// maxLinesStyle returns the inline style for max-height based on line count.
// Each line is roughly 1.4em tall at the body font size; we estimate at
// 20px per line (matches ds-codeblock-pre's line-height + padding).
func maxLinesStyle(max int) string {
	if max <= 0 {
		return ""
	}
	// 1.4em line-height × max lines + ~2.5rem padding (top+bottom)
	return "max-height: calc(" + itoa(max) + " * 1.4em + 2.5rem); overflow: auto;"
}

// itoa is a tiny strconv.Itoa without the import (templ files compile to Go,
// but keeping the dependency surface small here).
func itoa(n int) string {
	if n == 0 {
		return "0"
	}
	negative := n < 0
	if negative {
		n = -n
	}
	var buf [20]byte
	i := len(buf)
	for n > 0 {
		i--
		buf[i] = byte('0' + n%10)
		n /= 10
	}
	if negative {
		i--
		buf[i] = '-'
	}
	return string(buf[i:])
}

// languageClass returns the class for the <code> element, e.g. "language-yaml".
// Empty language yields no class.
func languageClass(lang string) string {
	if lang == "" {
		return ""
	}
	return "language-" + lang
}

// CodeBlock renders a <figure> with optional caption, optional copy button,
// and a <pre><code> block with the escaped code.
templ CodeBlock(props CodeBlockProps) {
	<figure
		class="ds-codeblock"
		if props.ID != "" {
			id={ props.ID }
		}
	>
		if props.Caption != "" || props.ShowCopy {
			<div class="ds-codeblock-header">
				if props.Caption != "" {
					<figcaption class="ds-codeblock-caption">{ props.Caption }</figcaption>
				}
				if props.ShowCopy {
					@CopyButton(CopyButtonProps{
						Text:  props.Code,
						Label: "Copy",
					})
				}
			</div>
		}
		if props.MaxLines > 0 {
			<pre class="ds-codeblock-pre" style={ maxLinesStyle(props.MaxLines) }>
				if props.Language != "" {
					<code class={ languageClass(props.Language) }>{ props.Code }</code>
				} else {
					<code>{ props.Code }</code>
				}
			</pre>
		} else {
			<pre class="ds-codeblock-pre">
				if props.Language != "" {
					<code class={ languageClass(props.Language) }>{ props.Code }</code>
				} else {
					<code>{ props.Code }</code>
				}
			</pre>
		}
	</figure>
}
