package layout

templ Base(props BaseProps) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ props.Title } — RezusCloud</title>
		@templ.Raw("<style>" + CSS() + "</style>")
		<script src="https://unpkg.com/htmx.org@2.0.4"></script>
		<script defer src="https://unpkg.com/alpinejs@3.14.8/dist/cdn.min.js"></script>
	</head>
	<body>
		if props.Page != "login" {
			<button class="ds-mobile-toggle" x-on:click="document.querySelector('.ds-sidebar').classList.toggle('ds-sidebar--open')">☰</button>
			<aside class="ds-sidebar">
				<div class="ds-sidebar-header">
					<div class="ds-sidebar-logo">
						<span class="ds-sidebar-logo-rezus">Rezus</span>
						<span class="ds-sidebar-logo-cloud">Cloud</span>
					</div>
				</div>
				<nav class="ds-sidebar-nav" aria-label="Main navigation">
					<a href="/" class={ templ.Classes("ds-sidebar-link", templ.KV("ds-sidebar-link--active", props.Page == "dashboard")) }>
						<svg class="ds-sidebar-icon" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.5l6.5 5v8h-4v-4h-5v4h-4v-8L8 1.5z"></path></svg>
						Overview
					</a>
					<a href="/tenants" class={ templ.Classes("ds-sidebar-link", templ.KV("ds-sidebar-link--active", props.Page == "tenants" || props.Page == "tenant")) }>
						<svg class="ds-sidebar-icon" viewBox="0 0 16 16" fill="currentColor"><path d="M2 2h5v5H2V2zm7 0h5v5H9V2zM2 9h5v5H2V9zm7 0h5v5H9V9z"></path></svg>
						Clusters
					</a>
				</nav>
				<div class="ds-sidebar-footer">
					if props.User != "" {
						<div class="ds-sidebar-user">{ props.User }</div>
						<a href="/logout" class="ds-sidebar-logout">Sign Out</a>
					}
				</div>
			</aside>
			<main class="ds-main">
				@props.Content
			</main>
		} else {
			@props.Content
		}
	</body>
	</html>
}
