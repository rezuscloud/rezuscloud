package pages

import "fmt"

templ TenantsList(tenants []TenantSummary) {
	<h1 class="ds-page-title">Clusters</h1>
	if len(tenants) == 0 {
		<div class="ds-empty-state">
			<div class="ds-empty-state-title">No clusters yet</div>
			<div class="ds-empty-state-desc">Create a cluster via the CLI: rezusctl create cluster &lt;name&gt;</div>
		</div>
	} else {
		<div class="ds-table-wrapper">
			<table class="ds-table">
				<thead>
					<tr>
						<th class="ds-table-th">Name</th>
						<th class="ds-table-th">Phase</th>
						<th class="ds-table-th">Machines</th>
					</tr>
				</thead>
				<tbody>
					for _, t := range tenants {
						<tr class="ds-table-row">
							<td class="ds-table-td"><a href={ templ.URL("/tenants/" + t.Name) }>{ t.Name }</a></td>
							<td class="ds-table-td"><span class={ "ds-status-badge ds-status-badge--" + phaseBadgeClass(t.Phase) }>{ t.Phase }</span></td>
							<td class="ds-table-td">{ fmt.Sprintf("%d / %d", t.Ready, t.Total) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
