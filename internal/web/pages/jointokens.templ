package pages

import "time"

// JoinTokensListData drives /machines/jointokens.
type JoinTokensListData struct {
	Tokens      []JoinTokenRow
	ClusterNames []string
	// NewToken is non-empty when the page is shown after creation. The UI shows
	// the token once with a copy button and the kernel-args preview.
	NewToken       string
	NewTokenExp    time.Time
	NewTokenCluster string
	NewTokenArgs   string // siderolink kernel args preview
	CanMutate      bool
}

// JoinTokenRow is one row in the token list.
type JoinTokenRow struct {
	Token      string // first 8 chars for display
	Cluster    string
	NodeGroup  string
	Status     string // "active", "used", "expired"
	ExpiresAt  string // formatted absolute time
	CreatedAt  string
}

// JoinTokensList renders /machines/jointokens.
templ JoinTokensList(data JoinTokensListData) {
	<div class="ds-page-header-row">
		<h1 class="ds-page-title">Join Tokens</h1>
		if data.CanMutate {
			<button type="button" class="ds-btn" data-modal-open="create-jointoken">Create Join Token</button>
		}
	</div>

	if data.NewToken != "" {
		@newTokenDisplay(data)
	}

	if len(data.Tokens) == 0 {
		<div class="ds-empty">
			<p>No join tokens yet.</p>
		</div>
	} else {
		<div class="ds-table-wrapper">
			<table class="ds-table">
				<thead>
					<tr>
						<th class="ds-table-th">Token</th>
						<th class="ds-table-th">Cluster</th>
						<th class="ds-table-th">Node Group</th>
						<th class="ds-table-th">Status</th>
						<th class="ds-table-th">Created</th>
						<th class="ds-table-th">Expires</th>
					</tr>
				</thead>
				<tbody>
					for _, t := range data.Tokens {
						<tr class="ds-table-row">
							<td class="ds-table-td"><code class="ds-code-inline">{ t.Token }</code></td>
							<td class="ds-table-td">
								if t.Cluster != "" {
									<a href={ templ.URL("/clusters/" + t.Cluster) }>{ t.Cluster }</a>
								} else {
									<span class="ds-text-muted">—</span>
								}
							</td>
							<td class="ds-table-td">{ t.NodeGroup }</td>
							<td class="ds-table-td">
								<span class={ "ds-status-badge ds-status-badge--" + tokenStatusBadgeClass(t.Status) }>{ t.Status }</span>
							</td>
							<td class="ds-table-td ds-text-muted">{ t.CreatedAt }</td>
							<td class="ds-table-td ds-text-muted">{ t.ExpiresAt }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}

	if data.CanMutate {
		@createJoinTokenModal(data)
	}
}

// newTokenDisplay shows the freshly-created token once.
templ newTokenDisplay(data JoinTokensListData) {
	<div class="ds-card ds-card--highlight">
		<h2 class="ds-card-title">Token created</h2>
		<p class="ds-text-muted">Copy this token now — you will not be able to see it again.</p>

		<div class="ds-input-group">
			<label class="ds-label">Token</label>
			<div class="ds-copy-row">
				<code class="ds-code-block" id="new-token-value">{ data.NewToken }</code>
				<button type="button" class="ds-btn ds-btn--sm ds-btn--secondary"
				        x-data="{ copied: false }"
				        x-on:click="navigator.clipboard.writeText(document.getElementById('new-token-value').innerText); copied = true"
				        x-on:mouseleave="setTimeout(() => copied = false, 1500)">
					<span x-show="!copied">Copy</span>
					<span x-show="copied" x-cloak>Copied!</span>
				</button>
			</div>
		</div>

		if data.NewTokenArgs != "" {
			<div class="ds-input-group">
				<label class="ds-label">Kernel args preview</label>
				<code class="ds-code-block ds-code-block--pre">{ data.NewTokenArgs }</code>
			</div>
			<p class="ds-text-muted ds-text-small">
				Boot your Talos machine with these kernel arguments to make it
				pull its configuration from this management cluster and register
				against the <strong>{ data.NewTokenCluster }</strong> cluster.
			</p>
		}
	</div>
}

// createJoinTokenModal renders the modal with the create form.
templ createJoinTokenModal(data JoinTokensListData) {
	<dialog id="create-jointoken" class="ds-modal">
		<form method="post" action="/machines/jointokens" class="ds-modal-body">
			<h2 class="ds-modal-title">Create Join Token</h2>

			<div class="ds-input-group">
				<label class="ds-label" for="jt-cluster">Cluster</label>
				<select id="jt-cluster" name="cluster" class="ds-input" required>
					<option value="">Select a cluster…</option>
					for _, c := range data.ClusterNames {
						<option value={ c }>{ c }</option>
					}
				</select>
			</div>

			<div class="ds-input-group">
				<label class="ds-label" for="jt-nodegroup">Node Group</label>
				<input type="text" id="jt-nodegroup" name="nodegroup" class="ds-input"
				       placeholder="workers" required/>
				<div class="ds-input-hint">The name of the node group the joining machine will be assigned to.</div>
			</div>

			<div class="ds-input-group">
				<label class="ds-label" for="jt-ttl">TTL</label>
				<select id="jt-ttl" name="ttl" class="ds-input">
					<option value="1h">1 hour</option>
					<option value="24h" selected>24 hours</option>
					<option value="168h">7 days</option>
					<option value="0">Never expires</option>
				</select>
			</div>

			<div class="ds-input-group">
				<label class="ds-label">
					<input type="checkbox" name="single_use" value="true"/>
					Single use (auto-deleted after one machine joins)
				</label>
			</div>

			<div class="ds-modal-footer">
				<button type="button" class="ds-btn ds-btn--secondary" data-modal-close>Cancel</button>
				<button type="submit" class="ds-btn">Create Token</button>
			</div>
		</form>
	</dialog>
}

// tokenStatusBadgeClass returns the badge variant for a token status.
func tokenStatusBadgeClass(status string) string {
	switch status {
	case "active":
		return "positive"
	case "used":
		return "neutral"
	case "expired":
		return "negative"
	default:
		return "neutral"
	}
}
