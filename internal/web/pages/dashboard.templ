package pages

import (
	"fmt"
	"strings"
)

type DashboardData struct {
	TenantCount    int
	MachineCount   int
	ProviderCount  int
	NodeGroupCount int
	Tenants        []TenantSummary
	LiveStream     bool // true when /events/stream is available

	// Posture cards (W14).
	Posture DashboardPosture
	// RecentAudit lists the most recent audit events (mutation activity).
	RecentAudit []AuditRow
	// ResourcePressure is nil when the metrics aggregator is not configured.
	ResourcePressure *ResourcePressureData
}

type DashboardPosture struct {
	Clusters  ClusterPosture
	Machines  MachinePosture
	Providers ProviderPosture
	Backups   BackupPosture
	Upgrades  UpgradePosture
}

type ClusterPosture struct {
	Active   int
	Forming  int
	Removing int
	Ready    int      // total machines healthy across all clusters
	Expected int      // total machines expected across all clusters
	Erroring []string // cluster names with degraded phase
}

type MachinePosture struct {
	Connected int
	Pending   int
	Failed    int // machines in stage_failed / stage_error
	Total     int
}

type ProviderPosture struct {
	Connected    int
	Disconnected int
	Errors       int
	Total        int
}

type BackupPosture struct {
	LastSuccess string // "never" or RFC3339
	Failures    int
	RPOLabel    string
}

type UpgradePosture struct {
	ActiveRuns      int
	BlockedPrecheck bool
	LatestTarget    string
	LatestPhase     string
}

type TenantSummary struct {
	Name  string
	Phase string
	Ready int
	Total int
}

// ResourcePressureData drives the resource pressure section on the dashboard.
// Nil when the metrics aggregator is not configured.
type ResourcePressureData struct {
	CPUUsage    int64 // millicores
	CPUCapacity int64 // millicores
	MemUsage    int64 // bytes
	MemCapacity int64 // bytes
	PodRunning  int
	PodCapacity int
	Nodes       int
	NodeDetails []NodePressureCard
}

// NodePressureCard is a compact node summary for the dashboard node grid.
type NodePressureCard struct {
	Name       string
	Role       string
	Status     string
	CPUPct     int
	MemPct     int
	PodPct     int
	DiskPct    int
	CPUUsed    int64 // millicores
	CPUAlloc   int64 // millicores
	MemUsed    int64 // bytes
	MemAlloc   int64 // bytes
	PodCount   int
	PodAlloc   int
	DiskUsed   int64 // bytes
	DiskTotal  int64 // bytes
	Conditions Conditions
}

// Conditions mirrors metrics.Conditions for template use.
type Conditions struct {
	Ready          string `json:"ready"`
	MemoryPressure string `json:"memoryPressure"`
	DiskPressure   string `json:"diskPressure"`
	PIDPressure    string `json:"pidPressure"`
}

templ Dashboard(data DashboardData) {
	<h1 class="ds-page-title">Overview</h1>
	<p class="ds-text-muted">Operational posture across the personal cloud.</p>
	@postureGrid(data)
	if data.ResourcePressure != nil {
		@resourcePressure(*data.ResourcePressure)
	}
	@clustersTable(data)
	@recentActivity(data)
}

// postureGrid renders five posture cards with drill-down links.
templ postureGrid(data DashboardData) {
	<div class="ds-grid ds-grid-4 ds-stats-row">
		@clusterPostureCard(data.Posture.Clusters)
		@machinePostureCard(data.Posture.Machines)
		@providerPostureCard(data.Posture.Providers)
		@backupPostureCard(data.Posture.Backups)
	</div>
	@upgradePostureBanner(data.Posture.Upgrades)
}

// clusterPostureCard shows the cluster lifecycle posture.
templ clusterPostureCard(p ClusterPosture) {
	<a class="ds-stat-block ds-stat-block--link" href="/clusters">
		<div class="ds-stat-label">Clusters</div>
		<div class="ds-stat-value">{ fmt.Sprintf("%d active", p.Active) }</div>
		<div class="ds-stat-sub">
			if p.Forming > 0 {
				<span class="ds-status-badge ds-status-badge--neutral">{ fmt.Sprintf("%d forming", p.Forming) }</span>
			}
			if p.Removing > 0 {
				<span class="ds-status-badge ds-status-badge--negative">{ fmt.Sprintf("%d removing", p.Removing) }</span>
			}
			if len(p.Erroring) > 0 {
				<span class="ds-status-badge ds-status-badge--negative" title={ strings.Join(p.Erroring, ", ") }>{ fmt.Sprintf("%d degraded", len(p.Erroring)) }</span>
			}
		</div>
		<div class="ds-stat-sub ds-text-muted">{ fmt.Sprintf("machines %d / %d", p.Ready, p.Expected) }</div>
	</a>
}

// machinePostureCard shows machine fleet posture.
templ machinePostureCard(p MachinePosture) {
	<a class="ds-stat-block ds-stat-block--link" href="/machines">
		<div class="ds-stat-label">Machines</div>
		<div class="ds-stat-value">{ fmt.Sprintf("%d / %d", p.Connected, p.Total) }</div>
		<div class="ds-stat-sub">
			if p.Pending > 0 {
				<span class="ds-status-badge ds-status-badge--neutral">{ fmt.Sprintf("%d pending", p.Pending) }</span>
			}
			if p.Failed > 0 {
				<span class="ds-status-badge ds-status-badge--negative">{ fmt.Sprintf("%d failed", p.Failed) }</span>
			}
		</div>
	</a>
}

// providerPostureCard shows provider adapter posture.
templ providerPostureCard(p ProviderPosture) {
	<a class="ds-stat-block ds-stat-block--link" href="/providers">
		<div class="ds-stat-label">Providers</div>
		<div class="ds-stat-value">{ fmt.Sprintf("%d / %d", p.Connected, p.Total) }</div>
		<div class="ds-stat-sub">
			if p.Errors > 0 {
				<span class="ds-status-badge ds-status-badge--negative">{ fmt.Sprintf("%d erroring", p.Errors) }</span>
			}
			if p.Disconnected > 0 {
				<span class="ds-status-badge ds-status-badge--neutral">{ fmt.Sprintf("%d disconnected", p.Disconnected) }</span>
			}
		</div>
	</a>
}

// backupPostureCard shows backup posture (RPO / failures).
templ backupPostureCard(p BackupPosture) {
	<a class="ds-stat-block ds-stat-block--link" href="/settings/backups">
		<div class="ds-stat-label">Backups</div>
		<div class="ds-stat-value" style="font-size:0.875rem;">{ p.LastSuccess }</div>
		<div class="ds-stat-sub">
			<span class="ds-status-badge ds-status-badge--neutral">{ "RPO " + p.RPOLabel }</span>
			if p.Failures > 0 {
				<span class="ds-status-badge ds-status-badge--negative">{ fmt.Sprintf("%d failures", p.Failures) }</span>
			}
		</div>
	</a>
}

// upgradePostureBanner shows a banner if an upgrade is running or blocked.
templ upgradePostureBanner(p UpgradePosture) {
	if p.ActiveRuns > 0 || p.BlockedPrecheck {
		<div class="ds-card" style="margin-top: 1rem;">
			<div class="ds-card-title-row">
				<h2 class="ds-card-title">Upgrade in progress</h2>
				<a class="ds-btn ds-btn--sm ds-btn--secondary" href="/clusters">View clusters →</a>
			</div>
			if p.ActiveRuns > 0 {
				<p>
					{ fmt.Sprintf("%d active upgrade run(s)", p.ActiveRuns) }
					if p.LatestTarget != "" {
						<span class="ds-text-muted">· target { p.LatestTarget } · phase { p.LatestPhase }</span>
					}
				</p>
			}
			if p.BlockedPrecheck {
				<p class="ds-text-danger">A precheck is blocked — see cluster upgrade tab for details.</p>
			}
		</div>
	}
}

// recentActivity shows the latest audit events (drill-down to /settings/audit).
templ recentActivity(data DashboardData) {
	<div class="ds-section-header" style="margin-top: 1rem;">Recent activity</div>
	if len(data.RecentAudit) == 0 {
		<div class="ds-empty"><p>No recent activity.</p></div>
	} else {
		<div class="ds-table-wrapper">
			<table class="ds-table">
				<thead>
					<tr>
						<th class="ds-table-th">Time</th>
						<th class="ds-table-th">User</th>
						<th class="ds-table-th">Verb</th>
						<th class="ds-table-th">Resource</th>
						<th class="ds-table-th">Status</th>
					</tr>
				</thead>
				<tbody>
					for _, ev := range data.RecentAudit {
						<tr class="ds-table-row">
							<td class="ds-table-td ds-text-muted">{ ev.Timestamp }</td>
							<td class="ds-table-td">{ ev.UserName }</td>
							<td class="ds-table-td">{ ev.Verb }</td>
							<td class="ds-table-td">
								if ev.ResourceID != "" {
									{ ev.Resource + "/" + ev.ResourceID }
								} else {
									{ ev.Resource }
								}
							</td>
							<td class="ds-table-td">
								<span class={ "ds-status-badge ds-status-badge--" + auditStatusBadgeClass(ev.Status) }>{ fmt.Sprintf("%d", ev.Status) }</span>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<p class="ds-text-muted ds-text-small" style="margin-top: 0.5rem;">
			<a href="/settings/audit">Full audit log →</a>
		</p>
	}
}

// resourcePressure renders the cluster-wide resource pressure section.
// Uses KPI tiles for cluster totals and node cards for per-node breakdown.
templ resourcePressure(data ResourcePressureData) {
	<div class="ds-section-header">Resource Pressure</div>
	<div class="ds-grid ds-grid-4" style="margin-bottom: 1.5rem;">
		@pressureTile("CPU", data.CPUUsage, data.CPUCapacity, "millicores")
		@pressureTileBytes("Memory", data.MemUsage, data.MemCapacity)
		@pressureTilePods("Pods", data.PodRunning, data.PodCapacity)
		@pressureTileCount("Nodes", int64(data.Nodes), "nodes")
	</div>
	if len(data.NodeDetails) > 0 {
		<div class="ds-section-header" style="margin-bottom: 0.75rem;">Nodes</div>
		<div class="ds-grid ds-grid-3" style="gap: 0.75rem;">
			for _, n := range data.NodeDetails {
				@nodePressureCard(n)
			}
		</div>
	}
}

// pressureTile renders a single KPI-like pressure tile for CPU (millicores).
templ pressureTile(label string, usage, capacity int64, unit string) {
	<div class="ds-pressure-tile">
		<div class="ds-pressure-tile-header">
			<span class="ds-pressure-tile-label">{ label }</span>
		</div>
		<div class="ds-pressure-tile-value">
			{ formatMillicores(usage) }<span class="ds-pressure-tile-unit"> / { formatMillicores(capacity) }</span>
		</div>
		@pressureBar(pctInt(usage, capacity))
	</div>
}

// pressureTileBytes renders a pressure tile for memory (bytes).
templ pressureTileBytes(label string, usage, capacity int64) {
	<div class="ds-pressure-tile">
		<div class="ds-pressure-tile-header">
			<span class="ds-pressure-tile-label">{ label }</span>
		</div>
		<div class="ds-pressure-tile-value">
			{ formatBytes(usage) }<span class="ds-pressure-tile-unit"> / { formatBytes(capacity) }</span>
		</div>
		@pressureBar(pctInt(usage, capacity))
	</div>
}

// pressureTilePods renders a pressure tile for pod counts.
templ pressureTilePods(label string, running, capacity int) {
	<div class="ds-pressure-tile">
		<div class="ds-pressure-tile-header">
			<span class="ds-pressure-tile-label">{ label }</span>
		</div>
		<div class="ds-pressure-tile-value">
			{ fmt.Sprintf("%d", running) }<span class="ds-pressure-tile-unit"> / { fmt.Sprintf("%d", capacity) }</span>
		</div>
		@pressureBar(pctInt(int64(running), int64(capacity)))
	</div>
}

// pressureTileCount renders a simple count tile without a bar.
templ pressureTileCount(label string, count int64, unit string) {
	<div class="ds-pressure-tile">
		<div class="ds-pressure-tile-header">
			<span class="ds-pressure-tile-label">{ label }</span>
		</div>
		<div class="ds-pressure-tile-value">
			{ fmt.Sprintf("%d", count) }<span class="ds-pressure-tile-unit"> { unit }</span>
		</div>
	</div>
}

// pressureBar renders a horizontal progress bar with threshold coloring.
templ pressureBar(pct int) {
	<div
		class="ds-pressure-bar"
		role="progressbar"
		aria-valuenow={ fmt.Sprintf("%d", pct) }
		aria-valuemin="0"
		aria-valuemax="100"
	>
		<div
			class={ "ds-pressure-bar-fill ds-pressure-bar-fill--" + pressureClass(pct) }
			style={ fmt.Sprintf("width: %d%%", pct) }
		></div>
	</div>
	<span class={ "ds-pressure-pct ds-pressure-pct--" + pressureClass(pct) }>{ fmt.Sprintf("%d%%", pct) }</span>
}

// nodePressureCard renders a compact card for a single node with resource bars.
templ nodePressureCard(n NodePressureCard) {
	<div class="ds-node-press-card">
		<div class="ds-node-press-header">
			<span class={ "ds-status-dot ds-status-dot--" + nodeStatusClass(n.Status) }></span>
			<span class="ds-node-press-name">{ n.Name }</span>
			<span class="ds-node-press-role">{ n.Role }</span>
		</div>
		<div class="ds-node-press-bars">
			@nodeBar("CPU", n.CPUPct, formatMillicores(n.CPUUsed), formatMillicores(n.CPUAlloc))
			@nodeBar("Mem", n.MemPct, formatBytes(n.MemUsed), formatBytes(n.MemAlloc))
			@nodeBar("Pods", n.PodPct, fmt.Sprintf("%d", n.PodCount), fmt.Sprintf("%d", n.PodAlloc))
			@nodeBar("Disk", n.DiskPct, formatBytes(n.DiskUsed), formatBytes(n.DiskTotal))
		</div>
	</div>
}

// nodeBar renders a labeled progress bar for a node resource.
templ nodeBar(label string, pct int, used, total string) {
	<div class="ds-node-press-row">
		<div class="ds-node-press-row-head">
			<span class="ds-node-press-row-label">{ label }</span>
			<span class="ds-node-press-row-value"><b>{ used }</b> / { total }</span>
		</div>
		<div
			class="ds-node-press-row-bar"
			role="progressbar"
			aria-valuenow={ fmt.Sprintf("%d", pct) }
			aria-valuemin="0"
			aria-valuemax="100"
		>
			<div
				class={ "ds-node-press-row-fill ds-node-press-row-fill--" + pressureClass(pct) }
				style={ fmt.Sprintf("width: %d%%", pct) }
			></div>
		</div>
	</div>
}

// clustersTable renders the cluster list.
templ clustersTable(data DashboardData) {
	if len(data.Tenants) > 0 {
		<div class="ds-section-header">Clusters</div>
		<div class="ds-table-wrapper">
			<table class="ds-table">
				<thead>
					<tr>
						<th class="ds-table-th">Name</th>
						<th class="ds-table-th">Phase</th>
						<th class="ds-table-th">Machines</th>
					</tr>
				</thead>
				<tbody>
					for _, t := range data.Tenants {
						<tr class="ds-table-row">
							<td class="ds-table-td"><a href={ templ.URL("/clusters/" + t.Name) }>{ t.Name }</a></td>
							<td class="ds-table-td"><span class={ "ds-status-badge ds-status-badge--" + phaseBadgeClass(t.Phase) }>{ t.Phase }</span></td>
							<td class="ds-table-td">{ fmt.Sprintf("%d / %d", t.Ready, t.Total) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
